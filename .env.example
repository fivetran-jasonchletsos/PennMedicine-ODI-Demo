# ============================================
# AWS EC2 SQL Server (Epic Clarity source)
# ============================================
SQLSERVER_HOST=<your-ec2-public-ip>
SQLSERVER_PORT=1433
SQLSERVER_USERNAME=admin
SQLSERVER_PASSWORD=<your-secure-password>
SQLSERVER_DATABASE=ehr_demo

# ============================================
# Fivetran (https://fivetran.com/account/settings)
# ============================================
FIVETRAN_API_KEY=<your-api-key>
FIVETRAN_API_SECRET=<your-api-secret>
FIVETRAN_CONNECTOR_ID=<your-sqlserver-connector-id>
FIVETRAN_DESTINATION_ID=<your-databricks-destination-id>

# ============================================
# Databricks destination + dbt target
# ============================================
DATABRICKS_HOST=<your-workspace>.cloud.databricks.com
DATABRICKS_HTTP_PATH=<retrieve-from-aws-secrets-manager>
DATABRICKS_TOKEN=<retrieve-from-aws-secrets-manager>

# Databricks Catalog and Schemas
DATABRICKS_CATALOG=jason_chletsos_pennmed
DATABRICKS_STAGING_SCHEMA=jason_chletsos_pennmed_staging
DATABRICKS_CLINICAL_SCHEMA=jason_chletsos_pennmed_clinical
DATABRICKS_FINANCIAL_SCHEMA=jason_chletsos_pennmed_financial

# Source schema where Fivetran lands CDC data
FIVETRAN_RAW_SCHEMA=jason_chletsos_pennmed_ehr_demo
SCHEMA_NAME=CLARITY
