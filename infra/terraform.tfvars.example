# AWS Configuration
aws_region  = "us-east-1"
aws_profile = "default"

# Database Credentials (EC2 SQL Server)
db_username = "admin"
db_password = "YourSecurePassword123!"
schema_name = "CLARITY"

# Fivetran Configuration
fivetran_api_key    = "your-fivetran-api-key"
fivetran_api_secret = "your-fivetran-api-secret"

# Group ID of the pre-existing Fivetran Databricks Unity Catalog
# destination (jason_chletsos_databricks) — the destination itself
# is not managed by this Terraform, only referenced by ID here.
fivetran_destination_id = "your-databricks-destination-group-id"

# Fivetran Qualtrics Connector Configuration
# data_center is found in your Qualtrics account URL, just before
# "qualtrics.com" (e.g. "iad1"). The client_id/client_secret/refresh_token
# come from a Qualtrics OAuth client application, obtained via Fivetran's
# connect-card OAuth flow or the Qualtrics API console.
qualtrics_data_center   = "iad1"
qualtrics_client_id     = "your-qualtrics-oauth-client-id"
qualtrics_client_secret = "your-qualtrics-oauth-client-secret"
qualtrics_refresh_token = "your-qualtrics-oauth-refresh-token"

# Fivetran Workday HCM Connector Configuration
# auth_mode = "BASIC" (Integration System User username/password, set up in
# Workday's own admin console) or "OAUTH" (client_id/client_secret/refresh_token
# from a Workday OAuth client app). Leave the unused auth path's fields blank.
workday_domain_host_name      = "your-tenant.workday.com"
workday_tenant                = "your-workday-tenant"
workday_auth_mode             = "BASIC"
workday_integration_system_id = ""
workday_subscriber_id         = ""
workday_username              = "your-workday-isu-username"
workday_password              = "your-workday-isu-password"
workday_client_id              = ""
workday_client_secret           = ""
workday_refresh_token           = ""

# Fivetran UKG Pro Workforce Management Connector Configuration
# auth_type = "client_credentials" or "ropc" - both obtained directly from
# UKG's own API console, no Fivetran dashboard OAuth popup needed.
ukg_auth_type       = "client_credentials"
ukg_organization    = "your-ukg-organization-id"
ukg_auth_environment = "your-ukg-auth-base-url"
ukg_host_name       = "your-ukg-hostname"
ukg_client_id       = "your-ukg-client-id"
ukg_client_secret   = "your-ukg-client-secret"
ukg_username        = "your-ukg-username"
ukg_password        = "your-ukg-password"
